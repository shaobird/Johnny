# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Gemini — OPTIONAL research layer (web search, intel briefing, newsletter) ─
# Leave BLANK to skip Gemini entirely — Johnny falls back to Claude's web search
# and works perfectly without it. Free tier on Gemini is restrictive; only worth
# the setup if you want a separate budget from Claude.
# To enable: aistudio.google.com/app/apikey  (free tier)
GEMINI_API_KEY=

# ── Ollama — local LLM (free, runs on your own machine) ──────────────────────
# After installing Ollama and pulling a model, this just works.
# Leave OLLAMA_BASE_URL as localhost if running on the same machine.
# Change to http://192.168.1.XX:11434 when running from a Mac Mini on your LAN.
OLLAMA_BASE_URL=http://localhost:11434
# Model to use. Recommendations by GPU VRAM:
#   10–12 GB (RTX 3080 / 4070 Ti)  →  qwen2.5:14b   ← recommended default
#   16–20 GB (RTX 4080 / 3090)     →  qwen2.5:32b
#   24 GB   (RTX 4090)             →  llama3.3:70b  ← best local quality
#   8 GB    (RTX 3070 / 4060)      →  qwen2.5:7b
OLLAMA_MODEL=qwen2.5:14b

# ── Telegram ─────────────────────────────────────────────────────────────────
# Create a bot via @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Start the bot, message it once, then copy the chat ID it shows you
TELEGRAM_CHAT_ID=your_personal_chat_id

# ── Google Calendar ──────────────────────────────────────────────────────────
# Download credentials.json from console.cloud.google.com
# (Enable Calendar API → OAuth2 credentials → Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Strava ───────────────────────────────────────────────────────────────────
# strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token

# ── Hevy ─────────────────────────────────────────────────────────────────────
# Hevy app → Profile → Settings → API Access
HEVY_API_KEY=your_hevy_api_key

# ── Smarty Managed Agent (auto-generated after running --setup) ──────────────
# Leave blank — populated automatically by: python -m agents.smarty_managed --setup
SMARTY_AGENT_ID=
SMARTY_AGENT_VERSION=
SMARTY_ENV_ID=

# ── Scheduler ────────────────────────────────────────────────────────────────
# 24h format — when Johnny sends the morning briefing
BRIEFING_TIME=07:00
# 24h format — when the daily intel briefing is sent (recommend 30–60 min after briefing)
INTEL_BRIEFING_TIME=07:30

# ── MrktEdge — High Impact news monitor ──────────────────────────────────────
# Polls every 10 min and pushes new HIGH IMPACT items to Telegram instantly
MRKTEDGE_EMAIL=your@email.com
MRKTEDGE_PASSWORD=yourpassword

# ── Forex Factory (optional overrides) ───────────────────────────────────────
# Set to true if Cloudflare blocks simple scraping (requires: pip install playwright)
FF_USE_PLAYWRIGHT=false
# Set to true to also include medium-impact (orange) events
FF_INCLUDE_MEDIUM=false
