# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Telegram ─────────────────────────────────────────────────────────────────
# Create a bot via @BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Start the bot, message it once, then copy the chat ID it shows you
TELEGRAM_CHAT_ID=your_personal_chat_id

# ── Google Calendar ──────────────────────────────────────────────────────────
# Download credentials.json from console.cloud.google.com
# (Enable Calendar API → OAuth2 credentials → Desktop app)
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Strava ───────────────────────────────────────────────────────────────────
# strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token

# ── Hevy ─────────────────────────────────────────────────────────────────────
# Hevy app → Profile → Settings → API Access
HEVY_API_KEY=your_hevy_api_key

# ── Scheduler ────────────────────────────────────────────────────────────────
# 24h format — when Johnny sends the morning briefing
BRIEFING_TIME=07:00
# 24h format — when the daily intel briefing is sent (recommend 30–60 min after briefing)
INTEL_BRIEFING_TIME=07:30

# ── MrktEdge — High Impact news monitor ──────────────────────────────────────
# Polls every 10 min and pushes new HIGH IMPACT items to Telegram instantly
MRKTEDGE_EMAIL=your@email.com
MRKTEDGE_PASSWORD=yourpassword

# ── Construction newsletter ──────────────────────────────────────────────────
# Day + 24h time for the weekly construction newsletter push (default Fri 17:00 SGT)
CONSTRUCTION_BRIEFING_DAY=fri
CONSTRUCTION_BRIEFING_TIME=17:00

# ── Email handoff (optional — for Manus AI pickup) ───────────────────────────
# After the construction newsletter generates, Johnny will email it to WORK_EMAIL
# with MANUS_SUBJECT_TAG prefixed in the subject line. Manus AI (or any inbox
# automation) can filter on that tag and take over from there.
# For Gmail, generate an app password at myaccount.google.com → Security → App passwords.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_gmail@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_gmail@gmail.com
WORK_EMAIL=your_work_email@company.com
MANUS_SUBJECT_TAG=[Manus]

# ── Forex Factory (optional overrides) ───────────────────────────────────────
# Set to true if Cloudflare blocks simple scraping (requires: pip install playwright)
FF_USE_PLAYWRIGHT=false
# Set to true to also include medium-impact (orange) events
FF_INCLUDE_MEDIUM=false
